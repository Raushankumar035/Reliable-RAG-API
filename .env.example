# ---- Required --------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# ---- LLM (optional) --------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Embeddings (optional) -------------------------------------------------
# fastembed = real local semantic model (downloads ~90 MB on first use)
# hash      = offline, non-semantic; for tests / smoke runs only
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store ----------------------------------------------------------
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=documents

# ---- Chunking / retrieval --------------------------------------------------
CHUNK_SIZE=200
CHUNK_OVERLAP=30
TOP_K=5
# Minimum cosine similarity for a chunk to be sent to the LLM (tune with evaluation/run_eval.py)
MIN_SIMILARITY=0.25

# ---- Misc ------------------------------------------------------------------
MAX_UPLOAD_MB=20
# Index data/sample_documents automatically when the API starts (idempotent)
INGEST_SAMPLES_ON_STARTUP=true
LOG_LEVEL=INFO
